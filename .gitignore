# Git ignore file for C++/CMake/Qt/vcpkg project

# Build directories
build/
# vcpkg installation directory
vcpkg_installed/

# Executables
*.exe
*.out

# Libraries
*.dll
*.lib
*.so
*.dylib
*.a

# Object files
*.obj
*.o

# Debug symbols
*.pdb
*.ilk

# CMake generated files
CMakeCache.txt
CMakeFiles/
install_manifest.txt
cmake_install.cmake
# .cmake files in build directory (e.g., from generated build scripts)
# This pattern is aggressive, may need refinement if you have custom .cmake files in build
/build/*.cmake

# IDE and OS specific files
# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.vcxproj.filters # Exclude filters, as they are often generated or user-specific
*.vcxproj.user

# Qt generated files
*_autogen/
moc_*.cpp
ui_*.h
qrc_*.cpp

# Editor backup files
*~
*.swp

# Logs and temporary files
*.log
*.tmp

# Installer files
*.msi
*.dmg
*.deb
*.rpm
